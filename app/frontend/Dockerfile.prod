# syntax=docker/dockerfile:1.4

# Stage 1: Build the application
# NOTE: Build from repo root: docker build -f app/frontend/Dockerfile.prod -t frontend .
FROM node:20-alpine AS builder

WORKDIR /app

# Accept build arguments
ARG VITE_BACKEND_URL

# Copy workspace package files first (better caching)
# Note: Skipping package-lock.json to let npm resolve platform-specific deps
COPY package.json ./
COPY app/frontend/package.json ./app/frontend/
COPY app/static-websites/package.json ./app/static-websites/
COPY app/deployment-runtime/package.json ./app/deployment-runtime/
COPY app/deployment-runtime/tailwind.config.js ./app/deployment-runtime/

# Set build-time environment variables (before install for native module handling)
ENV NODE_ENV=production \
    ROLLUP_USE_JS=true \
    LIGHTNINGCSS_USE_WASM=1 \
    LIGHTNINGCSS_NODEJS_FORCE_WASM=1 \
    VITE_BACKEND_URL=$VITE_BACKEND_URL

# Install dependencies (without lockfile for cross-platform compatibility)
RUN --mount=type=cache,target=/root/.npm \
    npm install --include=dev --no-audit --no-fund

# Copy source code
COPY app/frontend/ ./app/frontend/
COPY app/static-websites/ ./app/static-websites/

# Build application
WORKDIR /app/app/frontend
RUN npm run build

# Stage 2: Production with nginx
FROM nginx:alpine

# Copy built assets
COPY --from=builder /app/app/frontend/dist /usr/share/nginx/html

# Configure nginx for SPA routing and set permissions (single layer)
RUN echo 'server { \
    listen 8080; \
    location / { \
        root /usr/share/nginx/html; \
        try_files $uri $uri/ /index.html; \
    } \
}' > /etc/nginx/conf.d/default.conf && \
    sed -i 's/^user /#user /' /etc/nginx/nginx.conf && \
    sed -i 's|/run/nginx.pid|/tmp/nginx.pid|' /etc/nginx/nginx.conf && \
    chown -R nginx:nginx /var/cache/nginx /usr/share/nginx/html

USER nginx
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
