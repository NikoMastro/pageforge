rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Allowlist collection: a document exists for allowed uid or email
    match /allowlist/{docId} {
      allow read: if false; // prevent listing allowlist
      allow get: if isSignedIn(); // clients may check their own record
      allow create, update, delete: if false; // manage allowlist server-side only
    }

    // Allow authenticated users to create log entries in lps
    match /lps/{docId} {
      allow create: if isSignedIn();
      allow read, update, delete: if false;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}



