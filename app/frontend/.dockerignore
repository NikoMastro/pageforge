# Ignore dependencies and build outputs
node_modules
*/node_modules

# Monorepo workspace outputs
Flows/dist
PageForge/dist
dist
build

# Vite/Turbo caches
.vite
.turbo
.cache

# Git and local files
.git
.gitignore
.env
.env.*

