# MongoDB connection (showcase storage — replaces Firestore).
# Point this at your own cluster (e.g. a free MongoDB Atlas M0).
# e.g. mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=pageforge

# Showcase guardrails (defaults shown)
MAX_PAGES_PER_COLLECTION=10
MAX_VERSIONS_PER_PAGE=20

# Read-only media library (Cloudinary). The library lists a single folder.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_FOLDER=ShowcasePCH

# Admin token: required to modify or delete the permanent showcase pages
# (send as the x-admin-token header). Without it they are immutable.
# ADMIN_TOKEN=generate-a-long-random-string

# Showcase limits (defaults shown)
# MAX_PAGES_PER_COLLECTION=10
# NEW_PAGE_TTL_MS=3600000   # visitor pages expire after 1 hour
