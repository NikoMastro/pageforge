# MongoDB connection (showcase storage — replaces Firestore).
# Point this at your own cluster (e.g. a free MongoDB Atlas M0).
# e.g. mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=pageforge

# Showcase guardrails (defaults shown)
MAX_PAGES_PER_COLLECTION=50
MAX_VERSIONS_PER_PAGE=20
